# Yoco (payment)
YOCO_SECRET_KEY=sk_test_xxx
YOCO_PUBLIC_KEY=pk_test_xxx

# MailerLite (new API - use Bearer token from Integrations → Generate new token)
MAILERLITE_API_KEY=your_mailerlite_bearer_token
MAILERLITE_NEWSLETTER_GROUP=your_newsletter_group_id
MAILERLITE_RETREAT_GROUP=your_retreat_group_id

# Site URL (used for Yoco success/cancel redirects)
SITE_URL=http://localhost:3000

# --- Events calendar ---
# Postgres (Neon via the Vercel Marketplace sets this automatically; use the pooled URL)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Vercel Blob (set automatically when a Blob store is connected to the project)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# Resend (confirmation emails and admin sign-in links)
RESEND_API_KEY=re_xxx
MAIL_FROM="Brothers Rising <hello@brothersrising.com>"
# Yoco webhook secret (returned once when the webhook is registered; starts with whsec_)
YOCO_WEBHOOK_SECRET=whsec_xxx
# Admin sign-in: comma-separated approved emails, and a random string of 32+ characters
ADMIN_EMAILS=you@example.com,other@example.com
SESSION_PASSWORD=change-me-to-a-random-string-of-32-or-more-chars
# Optional: MailerLite group that event bookers are added to
MAILERLITE_EVENTS_GROUP=
